{
  "name": "autoapplymax",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Tooling and packaging for the AutoApplyMAX Chrome extension.",
  "scripts": {
    "clean": "node esbuild.config.mjs --clean",
    "build": "node esbuild.config.mjs",
    "package": "npm run build && rm -f autoapplymax-extension.zip && cd dist && zip -qr ../autoapplymax-extension.zip .",
    "dev": "node esbuild.config.mjs --watch",
    "suggest:adapters": "node scripts/suggest-adapter-fixes.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format:check": "prettier --check \"*.{json,js,mjs,ts}\" \".github/**/*.yml\" \"tests/**/*.{json,js,ts}\"",
    "test": "npm run test:unit",
    "test:unit": "vitest run --environment jsdom --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "validate:manifest": "node esbuild.config.mjs --validate-manifest",
    "ci": "npm run validate:manifest && npm run typecheck && npm run lint && npm run format:check && npm run test:unit && npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.8"
  }
}
